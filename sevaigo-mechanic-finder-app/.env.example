# =======================================================
# SevaiGo Environment Variables
# =======================================================

# 1. Database Connection (PostgreSQL / Supabase)
# For persistent production on Vercel, paste your Supabase Postgres connection string here.
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 2. Supabase Client Keys (Public)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Firebase Authentication (Free Phone OTP Testing)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app config
# Under Authentication -> Sign-in method -> Phone:
# Add test numbers under "Phone numbers for testing" (100% Free, No SMS Cost, No Blaze Plan needed)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# 4. Admin Credentials
SEVAIGO_ADMIN_EMAIL=admin@sevaigo.local
SEVAIGO_ADMIN_PASSWORD=adminpassword123
